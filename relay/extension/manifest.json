{
  "manifest_version": 3,
  "name": "FoundryVTT Max Headroom Relay",
  "version": "0.2.8",
  "description": "Relays Discord StreamKit voice activity, user discovery, and connection health to Foundry VTT.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pair this Foundry tab"
  },
  "content_scripts": [
    {
      "matches": [
        "https://streamkit.discord.com/overlay/voice/*"
      ],
      "js": [
        "streamkit-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://streamkit.discord.com/overlay/voice/*"
      ],
      "js": [
        "streamkit-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}