{{!-- templates/portrait-preferences.hbs --}}

<div class="max-headroom-portrait-preferences__content">

  {{!-- #region Preferences --}}

  <section class="max-headroom-portrait-preferences__section">

    <div class="form-group">
      <label>Portrait Bar Anchor</label>

      <select name="anchor">
        {{#each anchorChoices}}
          <option
            value="{{value}}"
            {{#if selected}}selected{{/if}}
          >
            {{label}}
          </option>
        {{/each}}
      </select>

      <p class="notes">
        Used when the bar does not have a custom dragged position.
      </p>
    </div>


    <div class="form-group">
      <label>Portrait Bar Orientation</label>

      <select name="orientation">
        {{#each orientationChoices}}
          <option
            value="{{value}}"
            {{#if selected}}selected{{/if}}
          >
            {{label}}
          </option>
        {{/each}}
      </select>
    </div>


    <div class="form-group">
      <label>Show User Names</label>

      <select name="showNames">
        {{#each showNameChoices}}
          <option
            value="{{value}}"
            {{#if selected}}selected{{/if}}
          >
            {{label}}
          </option>
        {{/each}}
      </select>
    </div>


    <div class="form-group">
      <label>Speaking Animation</label>

      <select name="animationEnabled">
        {{#each animationChoices}}
          <option
            value="{{value}}"
            {{#if selected}}selected{{/if}}
          >
            {{label}}
          </option>
        {{/each}}
      </select>
    </div>

  </section>

  {{!-- #endregion --}}


  {{!-- #region Position and Scale --}}

  <section class="max-headroom-portrait-preferences__section">

    <h3>
      Position and Scale
    </h3>

    <p>
      Current proportional scale:
      <strong>{{currentScalePercent}}%</strong>
    </p>

    <p class="notes">
      Unlock the small lock icon on the Portrait Bar to drag it or resize
      it proportionally from the corner.
    </p>

    <button
      type="button"
      data-action="resetPositionSize"
    >
      <i class="fa-solid fa-arrow-rotate-left"></i>
      Reset Position &amp; Size
    </button>

    <p class="notes">
      Reset uses the GM's anchor and tile-size defaults, clears custom
      screen coordinates, and restores scale to 100%.
    </p>

  </section>

  {{!-- #endregion --}}


  {{!-- #region Footer --}}

  <footer class="max-headroom-portrait-preferences__footer">

    <button type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      Save Preferences
    </button>

  </footer>

  {{!-- #endregion --}}

</div>